<div class="row">
    <div class="col-12 col-md-12">
        <h4>MonthReturn</h4>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th scope="col">@nameof(MonthReturn.Year)</th>
                        <th scope="col">@nameof(MonthReturn.Month)</th>
                        <th scope="col">@nameof(Counting.Total)</th>
                        <th scope="col">@nameof(Counting.TakeProfit)</th>
                        <th scope="col">@nameof(Counting.StopLoss)</th>
                        <th scope="col">@nameof(MonthReturn.InitialCash)</th>
                        <th scope="col">@nameof(MonthReturn.FinalCash)</th>
                        <th scope="col">@nameof(MonthReturn.FinalCashAVG)</th>
                        <th scope="col">@nameof(MonthReturn.WinRate)</th>
                        <th scope="col">@nameof(MonthReturn.PercentageReturn)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Strategy.Stats.Monthly)
                    {
                        <tr>
                            <td>@item.Year</td>
                            <td>@(new DateTime(item.Year, item.Month, 1).ToString("MMMM", CultureInfo.InvariantCulture))</td>
                            <td>@item.Counting.Total</td>
                            <td>@item.Counting.TakeProfit</td>
                            <td>@item.Counting.StopLoss</td>
                            <td>@item.InitialCash</td>
                            <td>@item.FinalCash</td>
                            <td>@item.FinalCashAVG</td>
                            <td>@item.WinRate</td>
                            <td>@item.PercentageReturn</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>